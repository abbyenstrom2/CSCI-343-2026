{
  "expo": {
    "name": "News",
    "slug": "News",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/newsSplash.jpeg",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/newsSplash.jpeg",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/newsSplash.jpeg"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/images/newsSplash.jpeg"
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen"
    ]
  }
}
